{
  "name": "@local/dsh-clock",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node test/host.test.mjs"
  },
  "description": "Live session clock in the composer dock plus a local_time tool for other IANA time zones",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
